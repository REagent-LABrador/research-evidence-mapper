{
  "$schema": "./node_modules/@biomejs/biome/configuration_schema.json",
  "extends": ["ultracite/biome/core"],
  "linter": {
    "rules": {
      "suspicious": {
        // Biome's type inference can't resolve zod's z.infer mapped types and
        // flags every switch/conditional over them as unreachable.
        "noUnnecessaryConditions": "off"
      },
      "style": {
        // Prefer `type` over `interface` (ultracite defaults to interface).
        "useConsistentTypeDefinitions": {
          "level": "error",
          "options": { "style": "type" }
        }
      }
    }
  },
  // Generated JSON is excluded for one reason: linting it puts the formatter
  // and the generator in a loop, so producing the artifact would make
  // `bun run check` fail.
  //   manifest.json  — written by scripts/deploy.ts in JSON.stringify's shape
  //   runs/*.json    — written by assemble.py's _dump (indent 2, sorted keys),
  //                    and `bun run validate` asserts runs/g_minimal.json is
  //                    byte-identical to a fresh assembly, which a reformat
  //                    breaks.
  "files": { "includes": ["!manifest.json", "!runs"] }
}
