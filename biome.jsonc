{
  "$schema": "./node_modules/@biomejs/biome/configuration_schema.json",
  "extends": ["ultracite/biome/core"],
  "linter": {
    "rules": {
      "suspicious": {
        // Biome's type inference can't resolve zod's z.infer mapped types and
        // flags every switch/conditional over them as unreachable.
        "noUnnecessaryConditions": "off"
      },
      "style": {
        // Prefer `type` over `interface` (ultracite defaults to interface).
        "useConsistentTypeDefinitions": {
          "level": "error",
          "options": { "style": "type" }
        }
      }
    }
  },
  // manifest.json is generated by scripts/deploy.ts on every deploy, in
  // JSON.stringify's formatting. Linting it puts the formatter and the
  // generator in a loop: every deploy would make `bun run check` fail.
  "files": { "includes": ["!manifest.json"] }
}
